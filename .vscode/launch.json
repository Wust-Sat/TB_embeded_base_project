{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/firmware.elf",
      "name": "Local Launch OpenOCD",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": [
        "${workspaceFolder}/stlink.cfg",
        "${workspaceFolder}/stm32u5x.cfg"
      ],
      "serverArgs": [
        "-c",
        "init; arm semihosting enable"
      ],
      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/STM32U575.svd",
      // "serialNumber": "49FF6D064978785146441667",
      "breakAfterReset": false
    },
    {
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/firmware.elf",
      "name": "Local Attach OpenOCD",
      "request": "attach",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": [
        "${workspaceFolder}/stlink.cfg",
        "${workspaceFolder}/stm32u5x.cfg"
      ],
      "serverArgs": [
        "-c",
        "init; arm semihosting enable"
      ],
      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/STM32U575.svd",
      "breakAfterReset": false
    },
    {
      "name": "Launch ST-GDB",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/firmware.elf",
      "request": "launch",
      "type": "cortex-debug",
      "runToEntryPoint": "main",
      "servertype": "stlink"
    }
  ]
}